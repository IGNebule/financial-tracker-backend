# Copy this file to .env and fill in real values.
# Do not commit .env — it is ignored by Git.

APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=REPLACE_ME    
APP_DB_NAME=REPLACE_ME
APP_DB_PASSWORD=REPLACE_ME
APP_DB_SSLMODE=disable

# Optional — defaults shown.
# In production (Hugging Face Spaces), set ADDR=:7860 and
# APP_DB_SSLMODE=require via the Space's secret settings.
ADDR=:8080
